<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cash_register.controller.MainController">

    <Button text="Kassenvorgang starten" fx:id="startSaleBtn" onAction="#handleStartSale"/>
    <Button text="Neues Produkt hinzufügen" fx:id="addProductBtn" onAction="#handleAddProduct"/>
    <Button text="Warenzugang erfassen" fx:id="stockInBtn" onAction="#handleStockIn"/>
    <Button text="Lagerbestand anzeigen" fx:id="showStockBtn" onAction="#handleShowStock"/>
    <Button text="Programm beenden" fx:id="exitBtn" onAction="#handleExit"/>

</VBox>